@import io.github.ygrip.testara.reporter.view.ReportView
@param ReportView view
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>${view.metadata().title()} · Interactive report</title>
  <style>
    :root{
      --bg:#F8FAFC;--surface:#FFFFFF;--border:#CBD5E1;--text:#0B1220;--muted:#64748B;
      --accent:#00AFA5;--accent-hover:#008B84;--accent-subtle:#ECFCFB;--mint:#5EF2D6;
      --success:#22C55E;--danger:#EF4444;--warning:#F59E0B;--info:#3B82F6;--radius:12px;
      --shadow:0 1px 0 rgba(255,255,255,.75) inset,0 7px 22px rgba(15,23,42,.065);
      --shadow-md:0 1px 0 rgba(255,255,255,.8) inset,0 15px 34px rgba(15,23,42,.11);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;-webkit-font-smoothing:antialiased}
    button,input,select{font:inherit}
    button{cursor:pointer}
    .page{width:min(1220px,calc(100% - 32px));margin:0 auto;padding:28px 0 40px}
    .surface-card{position:relative;overflow:hidden;background:linear-gradient(270deg,rgba(0,175,165,.055),transparent 72%) top right/100% 12px no-repeat,var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
    .surface-card:before{content:'';position:absolute;top:-1px;right:-1px;width:32px;height:32px;border-top:2px solid rgba(0,175,165,.58);border-right:2px solid rgba(0,175,165,.58);border-top-right-radius:inherit;pointer-events:none}
    .hero{background:#0B1220;color:#fff;margin-bottom:16px;padding:28px 30px 24px;box-shadow:0 14px 34px rgba(15,23,42,.16)}
    .hero:before{border-color:rgba(94,242,214,.75)}
    .hero-accent{position:absolute;left:0;right:0;top:0;height:4px;background:linear-gradient(90deg,var(--accent),var(--mint),var(--info))}
    .hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px}
    .brand-lockup{display:flex;gap:18px;align-items:flex-start;min-width:0}
    .brand-logo{display:block;max-width:150px;max-height:44px;width:auto;height:auto;object-fit:contain;margin-top:2px}
    .eyebrow{font-size:12px;line-height:17px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#A8EEE9}
    .eyebrow.dark{color:var(--accent-hover)}
    h1,h2,h3,p{margin:0}
    h1{font-size:31px;line-height:38px;letter-spacing:-.025em;margin-top:4px;font-weight:780;overflow-wrap:anywhere}
    h2{font-size:19px;line-height:26px;letter-spacing:-.012em;font-weight:780;margin-top:2px}
    h3{font-size:15px;line-height:21px;font-weight:760}
    .hero-subtitle{font-size:14px;line-height:20px;color:#CBD5E1;margin-top:7px}
    .overall-badge{display:inline-flex;align-items:center;border-radius:999px;padding:7px 11px;font-size:12px;line-height:16px;font-weight:850;letter-spacing:.045em;border:1px solid;white-space:nowrap}
    .overall-passed{color:#86EFAC;background:rgba(34,197,94,.13);border-color:rgba(34,197,94,.5)}
    .overall-failed{color:#FCA5A5;background:rgba(239,68,68,.13);border-color:rgba(239,68,68,.5)}
    .overall-pending{color:#FCD34D;background:rgba(245,158,11,.13);border-color:rgba(245,158,11,.5)}
    .hero-meta{display:flex;flex-wrap:wrap;gap:9px 18px;margin-top:22px;padding-top:17px;border-top:1px solid #243146;color:#CBD5E1;font-size:13px;line-height:19px}
    .overview-grid{display:grid;grid-template-columns:1.05fr 1fr 1.15fr;gap:14px;margin-bottom:14px}
    .hero-metric{padding:18px 19px;min-height:154px}
    .metric-icon-frame{width:32px;height:32px;border-radius:9px;background:var(--accent-subtle);border:1px solid #A8EEE9;color:var(--accent-hover);display:inline-flex;align-items:center;justify-content:center;font-weight:850;margin-bottom:12px}
    .metric-icon-frame.info{color:#2563EB;background:#EFF6FF;border-color:#BFDBFE}.metric-icon-frame.neutral{color:#475569;background:#F8FAFC;border-color:#CBD5E1}
    .metric-label{font-size:11px;line-height:16px;text-transform:uppercase;letter-spacing:.075em;font-weight:800;color:var(--muted)}
    .metric-value{font-size:29px;line-height:35px;font-weight:800;letter-spacing:-.025em;margin-top:4px;color:var(--text)}
    .metric-value.accent{color:var(--accent-hover)}.metric-value.compact{font-size:20px;line-height:28px}
    .metric-sub{font-size:13px;line-height:19px;color:var(--muted);margin-top:4px}
    .metric-progress{height:6px;border-radius:999px;background:#DCE6E8;overflow:hidden;margin-top:11px}.metric-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--mint))}
    .dashboard-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;margin-bottom:14px}
    .chart-card,.insight-card,.coverage-browser-card,.results-card{padding:20px}
    .section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:16px}.status-caption{font-size:12px;color:var(--muted);background:#F8FAFC;border:1px solid var(--border);border-radius:999px;padding:4px 8px;white-space:nowrap}
    .status-chart-wrap{display:grid;grid-template-columns:190px 1fr;gap:20px;align-items:center;min-height:205px}
    .donut{width:174px;height:174px;border-radius:50%;background:#E2E8F0;display:grid;place-items:center;position:relative;margin:auto;box-shadow:inset 0 0 0 1px rgba(15,23,42,.03)}
    .donut:after{content:'';position:absolute;width:112px;height:112px;border-radius:50%;background:#fff;box-shadow:0 0 0 1px #E2E8F0}
    .donut-center{position:relative;z-index:1;text-align:center;display:flex;flex-direction:column}.donut-center strong{font-size:26px;line-height:31px}.donut-center span{font-size:11px;color:var(--muted)}
    .status-legend{display:grid;gap:7px}.legend-row{display:grid;grid-template-columns:10px 1fr auto 42px;align-items:center;gap:8px;font-size:13px}.legend-dot{width:8px;height:8px;border-radius:50%}.legend-row strong{text-align:right}.legend-row small{text-align:right;color:var(--muted)}
    .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.info-item{border:1px solid var(--border);border-radius:9px;padding:10px 11px;background:#FBFDFD;min-width:0}.info-item span{display:block;color:var(--muted);font-size:11px;line-height:16px;text-transform:uppercase;letter-spacing:.05em;font-weight:750}.info-item strong{display:block;font-size:13px;line-height:19px;margin-top:2px;overflow-wrap:anywhere}
    .run-window{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #E2E8F0}.run-window span{font-size:12px;line-height:18px;color:var(--muted)}.run-window strong{display:block;color:var(--text);font-size:11px;text-transform:uppercase;letter-spacing:.05em}
    .status-metric-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:14px}.status-metric{display:flex;min-height:112px}.metric-strip{width:4px;flex:0 0 4px;background:linear-gradient(180deg,var(--metric-color),rgba(255,255,255,.3));box-shadow:2px 0 10px color-mix(in srgb,var(--metric-color),transparent 75%)}.status-metric-body{padding:14px 13px;flex:1;min-width:0}.status-metric-top{display:flex;align-items:center;justify-content:space-between;gap:7px;font-size:11px;line-height:16px;text-transform:uppercase;letter-spacing:.055em;font-weight:800;color:var(--muted)}.status-icon{width:25px;height:25px;border-radius:7px;background:var(--metric-bg);display:inline-flex;align-items:center;justify-content:center;color:var(--metric-color);font-size:15px}.status-metric-body>strong{display:block;font-size:25px;line-height:30px;margin-top:6px;color:var(--metric-color)}.status-metric-body>small{display:block;font-size:12px;line-height:17px;color:var(--muted);margin-top:2px}
    .insight-layout{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}.section-icon{width:31px;height:31px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;color:var(--accent-hover);background:var(--accent-subtle);border:1px solid #A8EEE9;font-weight:850}.section-icon.danger{color:#DC2626;background:#FEF2F2;border-color:#FECACA}.section-icon.info{color:#2563EB;background:#EFF6FF;border-color:#BFDBFE}
    .rank-list{display:grid;gap:11px}.rank-item{min-width:0}.rank-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-size:13px;line-height:18px}.rank-head>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:650}.rank-head strong{white-space:nowrap;font-size:12px}.rank-head small{color:var(--muted);font-weight:500}.bar-track{height:7px;border-radius:999px;overflow:hidden;background:#E2E8F0;margin-top:6px}.bar-track span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--mint))}.bar-track.danger span{background:linear-gradient(90deg,#EF4444,#FB7185)}.bar-track.info span{background:linear-gradient(90deg,#3B82F6,#60A5FA)}.rank-item>small{display:block;margin-top:4px;color:var(--muted);font-size:11px;line-height:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.danger-text{color:#DC2626}.subheading{margin:18px 0 10px;padding-top:14px;border-top:1px solid #E2E8F0}.compact-list{gap:9px}
    .healthy-state{display:flex;align-items:flex-start;gap:11px;padding:13px;border:1px solid #BBF7D0;border-radius:10px;background:#F0FDF4;color:#166534}.healthy-state>span{font-size:20px;font-weight:850}.healthy-state strong,.healthy-state small{display:block}.healthy-state small{font-size:12px;line-height:18px;margin-top:2px;color:#15803D}.empty-compact{border:1px dashed var(--border);border-radius:10px;padding:18px;color:var(--muted);font-size:13px;text-align:center;background:#FAFCFD}
    .coverage-browser-card{margin-bottom:14px}.coverage-browser-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.coverage-group{border:1px solid var(--border);border-radius:10px;overflow:hidden}.coverage-group-head{display:flex;justify-content:space-between;gap:10px;padding:10px 12px;background:#F8FAFC;border-bottom:1px solid var(--border);font-size:13px}.coverage-group-head span{color:var(--muted);font-size:12px}.coverage-browser-row{display:grid;grid-template-columns:1fr 130px;gap:14px;padding:11px 12px;border-bottom:1px solid #E2E8F0;align-items:center}.coverage-browser-row:last-child{border-bottom:0}.coverage-copy span,.coverage-copy small{display:block}.coverage-copy span{font-size:13px;font-weight:650}.coverage-copy small{font-size:11px;line-height:16px;color:var(--muted);margin-top:2px}.coverage-rate strong{display:block;text-align:right;font-size:12px;color:var(--accent-hover)}
    .results-card{overflow:visible}.results-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:15px}.results-heading p{font-size:13px;line-height:19px;color:var(--muted);margin-top:3px}.result-count{font-size:12px;color:var(--muted);white-space:nowrap}.result-count strong{color:var(--text)}
    .filter-toolbar{display:grid;grid-template-columns:minmax(220px,1.7fr) repeat(5,minmax(120px,.75fr)) auto auto;gap:8px;align-items:end;padding:12px;border:1px solid var(--border);border-radius:10px;background:#F8FAFC;margin-bottom:14px;position:sticky;top:8px;z-index:5;box-shadow:0 7px 20px rgba(15,23,42,.055)}
    .filter-toolbar label{display:block;min-width:0}.filter-toolbar label>span:first-child{display:block;font-size:10px;line-height:15px;text-transform:uppercase;letter-spacing:.055em;font-weight:800;color:var(--muted);margin:0 0 4px 1px}.filter-toolbar input[type=search],.filter-toolbar select{width:100%;height:36px;border:1px solid #B8C5D3;border-radius:8px;background:#fff;color:var(--text);padding:0 10px;font-size:13px;outline:none}.filter-toolbar input:focus,.filter-toolbar select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,175,165,.12)}.search-box{position:relative}.search-box>span{position:absolute;left:10px;top:6px;color:var(--muted);font-size:18px;pointer-events:none}.search-box input{padding-left:31px!important}
    .toggle-control{display:flex!important;align-items:center;gap:7px;height:36px;padding:0 9px;border:1px solid #B8C5D3;border-radius:8px;background:#fff;white-space:nowrap}.toggle-control>span:last-child{display:inline!important;margin:0!important;font-size:12px!important;line-height:16px!important;text-transform:none!important;letter-spacing:0!important;font-weight:650!important;color:var(--text)!important}.toggle-control input{position:absolute;opacity:0;pointer-events:none}.toggle-ui{width:28px;height:16px;border-radius:999px;background:#CBD5E1;position:relative;transition:.15s}.toggle-ui:after{content:'';position:absolute;width:12px;height:12px;border-radius:50%;background:#fff;left:2px;top:2px;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:.15s}.toggle-control input:checked+.toggle-ui{background:var(--accent)}.toggle-control input:checked+.toggle-ui:after{transform:translateX(12px)}.clear-button{height:36px;border:1px solid #B8C5D3;border-radius:8px;background:#fff;padding:0 11px;color:var(--accent-hover);font-size:12px;font-weight:750}.clear-button:hover,.detail-button:hover{border-color:var(--accent);background:var(--accent-subtle)}
    .table-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:10px}.results-table{width:100%;border-collapse:collapse;min-width:920px}.results-table th{padding:10px 11px;text-align:left;background:#F8FAFC;border-bottom:1px solid var(--border);font-size:10px;line-height:15px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:800;position:sticky;top:0}.results-table td{padding:11px;border-bottom:1px solid #E2E8F0;font-size:13px;line-height:18px;vertical-align:top}.results-table tr[data-scenario-row]:hover td{background:#FBFEFE}.results-table td strong{font-weight:700}.results-table td span,.results-table td small{display:block}.results-table td small{font-size:11px;line-height:16px;color:var(--muted);margin-top:2px}.right{text-align:right!important}.mono{font-family:ui-monospace,'Cascadia Code','SFMono-Regular',Consolas,monospace;font-size:12px!important}.muted{color:var(--muted)}.tag-list{font-size:11px!important;color:#0F766E;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.scenario-status{display:inline-flex!important;width:max-content;border-radius:999px;padding:4px 7px;font-size:10px!important;line-height:14px!important;font-weight:850!important;letter-spacing:.045em;border:1px solid}.status-passed{color:#15803D;background:#F0FDF4;border-color:#BBF7D0}.status-failed{color:#B91C1C;background:#FEF2F2;border-color:#FECACA}.status-skipped{color:#475569;background:#F8FAFC;border-color:#CBD5E1}.status-pending{color:#B45309;background:#FFFBEB;border-color:#FDE68A}.status-undefined{color:#C2410C;background:#FFF7ED;border-color:#FED7AA}.detail-button{height:28px;border:1px solid #B8C5D3;border-radius:7px;background:#fff;color:var(--accent-hover);padding:0 9px;font-size:11px;font-weight:750}
    .scenario-detail-cell{padding:0!important;background:#F8FAFC}.scenario-detail{padding:18px 20px;border-left:3px solid var(--accent);background:#FBFEFE}.detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.detail-head h3{font-size:17px;line-height:23px;margin-top:3px}.detail-meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin:13px 0;padding:10px 0;border-top:1px solid #E2E8F0;border-bottom:1px solid #E2E8F0}.detail-meta span{font-size:12px;color:var(--muted)}.detail-meta strong{display:block;font-size:10px;line-height:15px;text-transform:uppercase;letter-spacing:.055em;color:var(--text)}.error-panel{margin:12px 0;border:1px solid #FECACA;border-radius:9px;background:#FFF8F8;overflow:hidden}.error-title{padding:8px 10px;color:#B91C1C;font-size:12px;font-weight:800;border-bottom:1px solid #FEE2E2}.error-title span{display:inline-flex!important;width:19px;height:19px;border-radius:6px;background:#FEE2E2;align-items:center;justify-content:center;margin-right:6px}.error-panel pre,.step-copy pre{margin:0;padding:10px;white-space:pre-wrap;overflow-wrap:anywhere;font-family:ui-monospace,'Cascadia Code','SFMono-Regular',Consolas,monospace;font-size:12px;line-height:18px;color:#7F1D1D}.step-list{border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff}.step-row{display:grid;grid-template-columns:12px 1fr 110px;gap:9px;padding:9px 11px;border-bottom:1px solid #E2E8F0;align-items:start}.step-row:last-child{border-bottom:0}.step-dot{width:8px;height:8px;border-radius:50%;margin-top:6px;background:#94A3B8}.status-bg-passed{background:var(--success)}.status-bg-failed{background:var(--danger)}.status-bg-pending{background:var(--warning)}.status-bg-skipped{background:#64748B}.status-bg-undefined{background:#F97316}.step-copy{min-width:0}.step-copy>strong{display:inline;font-size:12px;line-height:18px}.step-keyword{display:inline!important;color:var(--accent-hover);font-size:11px!important;font-weight:800;margin-right:5px}.step-duration{text-align:right;color:var(--muted);font-size:11px!important}.step-copy pre{margin-top:6px;background:#FEF2F2;border-radius:7px;padding:7px}.empty-results{padding:34px;text-align:center;color:var(--muted)}.empty-results>span{display:block;font-size:28px}.empty-results strong,.empty-results small{display:block}.empty-results strong{font-size:14px;color:var(--text);margin-top:6px}.empty-results small{font-size:12px;margin-top:2px}
    .interactive-footer{display:flex;justify-content:space-between;gap:20px;padding:20px 4px 0;color:var(--muted);font-size:12px;line-height:18px}.interactive-footer strong,.interactive-footer span{display:block}.interactive-footer strong{color:var(--text)}.footer-note{text-align:right}
    [hidden]{display:none!important}
    @@media (max-width:1080px){.filter-toolbar{grid-template-columns:1.5fr repeat(3,minmax(120px,1fr));}.filter-toolbar label:nth-of-type(5),.filter-toolbar label:nth-of-type(6),.toggle-control,.clear-button{grid-row:2}.status-metric-grid{grid-template-columns:repeat(3,1fr)}.coverage-browser-grid{grid-template-columns:1fr}}
    @@media (max-width:820px){.page{width:min(100% - 20px,1220px);padding-top:14px}.hero{padding:24px 20px}.hero-top{display:block}.overall-badge{margin-top:14px}.brand-lockup{display:block}.brand-logo{margin-bottom:12px}.overview-grid,.dashboard-grid,.insight-layout{grid-template-columns:1fr}.status-chart-wrap{grid-template-columns:160px 1fr}.donut{width:150px;height:150px}.donut:after{width:96px;height:96px}.status-metric-grid{grid-template-columns:repeat(2,1fr)}.filter-toolbar{position:static;grid-template-columns:1fr 1fr}.filter-toolbar>*{grid-row:auto!important}.search-control{grid-column:1/-1}.coverage-browser-row{grid-template-columns:1fr 110px}.interactive-footer{display:block}.footer-note{text-align:left;margin-top:6px}}
    @@media (max-width:520px){body{font-size:14px;line-height:21px}.page{width:100%;padding:0 0 24px}.surface-card{border-radius:0;border-left:0;border-right:0}.hero{margin-bottom:10px}.overview-grid,.dashboard-grid,.insight-layout,.status-metric-grid{gap:10px;margin-bottom:10px}.overview-grid,.dashboard-grid,.insight-layout,.status-metric-grid{grid-template-columns:1fr}.chart-card,.insight-card,.coverage-browser-card,.results-card{padding:16px}.status-chart-wrap{grid-template-columns:1fr}.status-legend{grid-template-columns:1fr 1fr}.info-grid,.run-window{grid-template-columns:1fr}.filter-toolbar{grid-template-columns:1fr}.search-control{grid-column:auto}.coverage-browser-row{grid-template-columns:1fr}.coverage-rate strong{text-align:left}.interactive-footer{padding:16px}.hero-meta{display:grid;grid-template-columns:1fr 1fr}h1{font-size:27px;line-height:34px}}
  </style>
</head>
<body>
<main class="page">
  @template.component.interactiveHeader(view)
  @template.component.interactiveOverview(view)
  @template.component.interactiveInsights(view)
  @template.component.interactiveResults(view)
  @template.component.interactiveFooter(view)
</main>
@template.component.interactiveScript()
</body>
</html>
