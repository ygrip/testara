<style>
  .quality-signal{padding:19px 20px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.055));border-color:rgba(190,230,226,.24)}
  .quality-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}.quality-context{margin-top:3px;color:#B8C8D5;font-size:11px}.quality-score-row{display:flex;align-items:flex-end;gap:10px;margin-top:14px}.quality-score-row .overall-value{font-size:44px;line-height:.95;margin:0;letter-spacing:-.045em}.quality-score-copy{color:#C9D6E2;font-size:11px;line-height:1.25}.quality-track{height:8px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.11);margin-top:14px}.quality-track>span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--teal),var(--cyan))}.quality-breakdown{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:13px}.quality-stat{display:grid;grid-template-columns:8px minmax(0,1fr) auto;gap:6px;align-items:center;padding:7px 8px;border:1px solid rgba(255,255,255,.10);border-radius:8px;background:rgba(255,255,255,.045);font-size:10px;color:#DCE5EF}.quality-stat strong{font-size:11px;color:#FFF}.quality-dot{width:7px;height:7px;border-radius:50%}

  .coverage-scroll{max-height:500px;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding-right:3px}.coverage-scroll:focus{outline:2px solid rgba(0,175,165,.2);outline-offset:4px;border-radius:10px}.coverage-scroll::-webkit-scrollbar{width:9px}.coverage-scroll::-webkit-scrollbar-thumb{background:#C5D3DA;border:2px solid transparent;border-radius:999px;background-clip:padding-box}.coverage-scroll::-webkit-scrollbar-track{background:transparent}

  .explorer-stage{overflow:hidden;min-width:0}.explorer-primary{grid-template-columns:minmax(0,1fr) 42px}.explorer-filter-rail{display:grid}.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:#718092;pointer-events:none}.clear-icon-button{width:42px;height:40px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:9px;background:#FFF;color:#5D6B78}.clear-icon-button:hover{color:var(--teal-dark);border-color:#9CD9D5;background:#F5FFFE}.clear-icon-button:focus-visible,.back-button:focus-visible,[data-open-scenario]:focus-visible{outline:3px solid rgba(0,175,165,.16);outline-offset:2px}
  .scenario-table tbody tr[data-open-scenario]{cursor:pointer;transition:background-color .16s ease,box-shadow .16s ease}.scenario-table tbody tr[data-open-scenario]:hover{background:#F4FCFB;box-shadow:inset 3px 0 0 var(--teal)}.scenario-table tbody tr[data-open-scenario]:focus-visible{position:relative;z-index:2}

  .scenario-detail-view{width:100%;max-width:100%;min-width:0;overflow-x:clip}.scenario-detail-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-bottom:15px;margin-bottom:18px;border-bottom:1px solid var(--line)}.back-button{height:38px;display:inline-flex;align-items:center;gap:7px;border:1px solid #A9D9D5;border-radius:9px;padding:0 12px;background:linear-gradient(135deg,#F1FFFD,#FBFFFF);color:var(--teal-dark);font-weight:750;font-size:12px}.detail-hint{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:800}.scenario-detail-panel{width:100%;max-width:100%;min-width:0}.scenario-detail-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding:2px 0 18px}.scenario-detail-head>div:first-child{min-width:0;max-width:100%}.scenario-detail-head h3{font-size:26px;line-height:1.2;margin:8px 0 5px}.scenario-detail-head p{color:var(--muted);font-size:13px}.scenario-detail-head h3,.scenario-detail-head p,.detail-tags,.step-title-row strong{overflow-wrap:anywhere;word-break:break-word}.scenario-detail-kicker{display:flex;flex-wrap:wrap;gap:7px;align-items:center}.example-badge{display:inline-flex;padding:5px 8px;border:1px solid #DDD6FE;border-radius:999px;background:var(--violet-soft);color:#6D28D9;font-size:10px;font-weight:800}.detail-tags{margin-top:8px;color:var(--teal-dark);font-size:12px}.detail-duration{min-width:96px;text-align:right}.detail-duration span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;font-weight:800;letter-spacing:.06em}.detail-duration strong{display:block;margin-top:3px;font-size:20px}.scenario-error{margin-bottom:18px}.detail-section-head{display:flex;justify-content:space-between;align-items:end;margin:20px 0 10px}.detail-section-head h4{margin:2px 0 0;font-size:16px}.rich-step-list{gap:9px}.rich-step-item{grid-template-columns:12px minmax(0,1fr);padding:13px 14px;align-items:start}.rich-step-list,.rich-step-item,.step-content,.step-artifact,.attachment-grid,.attachment-card{min-width:0;max-width:100%}.step-content{min-width:0}.step-title-row{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.step-title-row strong{font-size:13px}.step-duration{white-space:nowrap;color:var(--muted);font-size:11px}.step-error{margin-top:9px}.scenario-detail-view .error-box{max-width:100%;overflow-wrap:anywhere;word-break:break-word}.step-artifact{margin-top:11px;padding-top:10px;border-top:1px dashed #D9E2E8}.artifact-label{margin-bottom:7px;color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.step-data-table-shell{width:100%;max-width:100%;overflow-x:auto;border:1px solid var(--line);border-radius:9px;background:#FFF}.step-data-table{width:max-content;min-width:100%;border-collapse:collapse}.step-data-table td{padding:8px 10px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}.step-data-table tr:first-child td{background:#F8FBFC;font-weight:750}.step-data-table tr:last-child td{border-bottom:0}.step-data-table td:last-child{border-right:0}.step-doc-string{margin:0;max-width:100%;max-height:320px;overflow:auto;padding:11px 12px;border:1px solid #D8E1E7;border-radius:9px;background:#0F172A;color:#D7E3ED;font:12px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}.attachment-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));width:100%;gap:10px}.attachment-card{margin:0;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:10px;background:#FFF}.attachment-image,.attachment-video{display:block;width:100%;max-width:100%;max-height:420px;object-fit:contain;background:#F2F5F7}.attachment-card figcaption{padding:8px 10px;color:var(--muted);font-size:11px;overflow-wrap:anywhere}.attachment-audio{min-width:0;max-width:100%;padding:10px}.attachment-audio audio{width:100%;max-width:100%}.attachment-audio span{display:block;margin-top:6px;font-size:11px;color:var(--muted);overflow-wrap:anywhere}.attachment-file{display:block;max-width:100%;padding:10px 12px;border:1px solid #B9DAD7;border-radius:9px;background:#F3FCFB;color:var(--teal-dark);font-size:12px;font-weight:700;text-decoration:none;overflow-wrap:anywhere;word-break:break-word}

@@media(max-width:620px){
  .quality-breakdown{grid-template-columns:1fr 1fr}.quality-score-row .overall-value{font-size:38px}.coverage-scroll{max-height:420px}.explorer-primary{grid-template-columns:minmax(0,1fr) 40px}.control-primary.explorer-primary .search-shell{grid-column:auto}.clear-icon-button{width:40px}.explorer-filter-rail{display:flex!important;gap:8px;overflow-x:auto;padding:9px 2px 3px;margin-top:8px;scroll-snap-type:x proximity;scrollbar-width:none}.explorer-filter-rail::-webkit-scrollbar{display:none}.explorer-filter-rail .control-label{flex:0 0 152px;scroll-snap-align:start}.mobile-sort-strip{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}.mobile-sort-strip::-webkit-scrollbar{display:none}.scenario-detail-toolbar{position:sticky;top:6px;z-index:6;margin:-5px -4px 14px;padding:8px 4px 11px;background:rgba(255,255,255,.95);backdrop-filter:blur(8px)}.detail-hint{display:none}.scenario-detail-head{display:block}.detail-duration{text-align:left;margin-top:12px}.scenario-detail-head h3{font-size:22px}.attachment-grid{grid-template-columns:minmax(0,1fr)}.step-title-row{display:block}.step-duration{display:block;margin-top:3px}
}

@@media(prefers-reduced-motion:reduce){.scenario-table tbody tr[data-open-scenario]{transition:none}}
</style>
