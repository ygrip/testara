<style>
@@media(max-width:620px){
.control-primary{grid-template-columns:repeat(3,minmax(0,1fr))}.search-shell{grid-column:1/-1}.mobile-filter-toggle{display:inline-flex}.control-secondary{display:none}.control-secondary.is-open{display:grid}.mobile-sort-strip{display:flex;gap:6px;overflow-x:auto}.mobile-sort-button{flex:0 0 auto;padding:7px 10px;border:1px solid var(--line-strong);border-radius:999px;background:#fff}.scenario-table td{grid-template-columns:82px minmax(0,1fr)}}
</style>