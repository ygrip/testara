<style>
  :root{
    color-scheme:light;
    --page:#F4F7FB;--surface:rgba(255,255,255,.76);--surface-strong:rgba(255,255,255,.92);
    --ink:#0B1220;--muted:#637083;--line:rgba(126,145,166,.26);--grid:rgba(39,88,111,.055);
    --teal:#00AFA5;--teal-dark:#007E78;--mint:#5EF2D6;--blue:#3B82F6;--violet:#7868E6;
    --green:#22C55E;--red:#EF4444;--amber:#F59E0B;--slate:#64748B;
    --radius:22px;--radius-sm:14px;--shadow:0 18px 54px -32px rgba(24,45,68,.36),0 2px 8px rgba(24,45,68,.05);
    --shadow-float:0 28px 70px -34px rgba(24,45,68,.46),0 8px 22px rgba(24,45,68,.08);
    --body-font:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,Helvetica,sans-serif;
    --display-font:"Avenir Next","Segoe UI Variable",var(--body-font);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;background:var(--page)}
  body{margin:0;min-width:320px;color:var(--ink);font-family:var(--body-font);font-size:15px;line-height:1.5;background:
    radial-gradient(circle at 12% 0%,rgba(0,175,165,.14),transparent 28rem),
    radial-gradient(circle at 92% 8%,rgba(120,104,230,.13),transparent 30rem),
    radial-gradient(circle at 70% 72%,rgba(59,130,246,.09),transparent 34rem),var(--page);font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
  body:before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:36px 36px;mask-image:radial-gradient(ellipse 90% 70% at 50% 5%,#000 0%,rgba(0,0,0,.7) 42%,transparent 88%)}
  button,input,select{font:inherit}
  button{cursor:pointer}
  h1,h2,h3,p{margin:0}
  h1,h2,h3{font-family:var(--display-font);letter-spacing:-.025em;text-wrap:balance}
  .report-page{width:min(1280px,calc(100% - 32px));margin:0 auto;padding:30px 0 44px}
  .glass-card{position:relative;isolation:isolate;overflow:hidden;border:1px solid rgba(155,171,190,.34);border-radius:var(--radius);background:linear-gradient(145deg,rgba(255,255,255,.88),rgba(255,255,255,.66));box-shadow:var(--shadow);-webkit-backdrop-filter:blur(18px) saturate(1.12);backdrop-filter:blur(18px) saturate(1.12)}
  .glass-card:before{content:"";position:absolute;inset:0;z-index:-2;border-radius:inherit;background-image:linear-gradient(rgba(39,88,111,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(39,88,111,.04) 1px,transparent 1px);background-size:28px 28px;mask-image:radial-gradient(ellipse 80% 70% at 100% 0%,#000 0%,rgba(0,0,0,.55) 42%,transparent 80%)}
  .glass-card:after{content:"";position:absolute;z-index:-1;top:-45%;right:-22%;width:64%;height:100%;border-radius:48% 52% 68% 32%;background:linear-gradient(135deg,transparent 12%,rgba(0,175,165,.13),rgba(120,104,230,.08),transparent 74%);filter:blur(32px);transform:rotate(-18deg);pointer-events:none}
  .bento-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-flow:dense;gap:14px;margin-top:14px}
  .span-12{grid-column:span 12}.span-8{grid-column:span 8}.span-7{grid-column:span 7}.span-6{grid-column:span 6}.span-5{grid-column:span 5}.span-4{grid-column:span 4}
  .card-pad{padding:22px}
  .card-eyebrow{font-size:11px;font-weight:850;letter-spacing:.09em;text-transform:uppercase;color:var(--teal-dark)}
  .card-title{font-size:19px;line-height:1.25;font-weight:760;margin-top:3px}
  .card-subtitle{font-size:13px;line-height:1.45;color:var(--muted);margin-top:4px}
  .card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px}
  .icon-tile{width:38px;height:38px;display:grid;place-items:center;flex:0 0 38px;border-radius:12px;border:1px solid rgba(0,175,165,.2);background:rgba(216,251,243,.76);color:var(--teal-dark);font-size:18px;font-weight:850;box-shadow:inset 0 1px 0 rgba(255,255,255,.85)}
  .icon-tile.danger{color:#B91C1C;background:rgba(254,226,226,.78);border-color:rgba(239,68,68,.2)}
  .icon-tile.info{color:#1D4ED8;background:rgba(219,234,254,.8);border-color:rgba(59,130,246,.2)}
  .hero{position:relative;overflow:hidden;border-radius:30px;padding:30px 32px 28px;color:#F9FAFB;background:linear-gradient(125deg,rgba(8,19,34,.98),rgba(14,31,48,.95) 52%,rgba(16,47,61,.92));box-shadow:0 32px 74px -36px rgba(7,18,31,.68)}
  .hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(168,238,233,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(168,238,233,.07) 1px,transparent 1px);background-size:30px 30px;mask-image:radial-gradient(ellipse 74% 80% at 100% 0%,#000 0%,rgba(0,0,0,.52) 48%,transparent 88%)}
  .hero:after{content:"";position:absolute;width:440px;height:440px;right:-170px;top:-240px;border-radius:50%;background:radial-gradient(circle,rgba(94,242,214,.28),rgba(59,130,246,.15) 42%,transparent 70%);filter:blur(8px)}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.72fr);gap:28px;align-items:end}
  .brand-row{display:flex;align-items:center;gap:14px;margin-bottom:20px}.brand-logo{display:block;max-width:150px;max-height:42px;width:auto;height:auto;object-fit:contain}.brand-name{font-size:12px;font-weight:850;letter-spacing:.09em;text-transform:uppercase;color:#A8EEE9}
  .hero h1{font-size:clamp(30px,4vw,46px);line-height:1.04;font-weight:780;max-width:760px}
  .hero-copy{max-width:720px;color:#CBD5E1;font-size:14px;margin-top:10px}
  .hero-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.hero-chip{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid rgba(226,232,240,.16);border-radius:999px;background:rgba(255,255,255,.07);color:#DCE5EF;font-size:12px;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
  .overall-panel{position:relative;border:1px solid rgba(226,232,240,.15);border-radius:22px;padding:20px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.055));box-shadow:inset 0 1px 0 rgba(255,255,255,.12);-webkit-backdrop-filter:blur(20px) saturate(1.18);backdrop-filter:blur(20px) saturate(1.18)}
  .overall-label{font-size:11px;letter-spacing:.09em;text-transform:uppercase;font-weight:850;color:#A8EEE9}.overall-value{font-size:36px;line-height:1.08;font-weight:820;margin-top:5px}.overall-caption{font-size:12px;color:#CBD5E1;margin-top:4px}.overall-status{display:inline-flex;margin-top:14px;padding:6px 9px;border-radius:999px;font-size:11px;font-weight:850;letter-spacing:.05em;border:1px solid rgba(255,255,255,.16)}
  .status-PASSED{color:#86EFAC;background:rgba(34,197,94,.14)}.status-FAILED{color:#FCA5A5;background:rgba(239,68,68,.14)}.status-PENDING{color:#FCD34D;background:rgba(245,158,11,.14)}
  .metric-card{min-height:170px}.metric-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.metric-label{font-size:11px;text-transform:uppercase;letter-spacing:.075em;font-weight:850;color:var(--muted)}.metric-value{font-family:var(--display-font);font-size:34px;line-height:1.08;font-weight:800;letter-spacing:-.035em;margin-top:7px}.metric-value.teal{color:var(--teal-dark)}.metric-note{font-size:13px;color:var(--muted);margin-top:5px}.mini-progress{height:8px;border-radius:999px;background:#DDE6EC;overflow:hidden;margin-top:16px}.mini-progress>span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--teal),var(--mint))}
  .status-chart-card{min-height:330px}.chart-layout{display:grid;grid-template-columns:minmax(240px,.75fr) 1fr;gap:24px;align-items:center}.radial-chart{width:230px;height:230px;margin:auto;border-radius:50%;position:relative;display:grid;place-items:center;background:conic-gradient(var(--green) 0 var(--pass),rgba(203,213,225,.7) var(--pass) 100%);box-shadow:0 20px 45px -24px rgba(0,175,165,.44)}.radial-chart:before{content:"";position:absolute;inset:28px;border-radius:50%;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(244,250,250,.9));box-shadow:inset 0 0 0 1px rgba(155,171,190,.28)}.radial-center{position:relative;text-align:center}.radial-center strong{display:block;font-family:var(--display-font);font-size:42px;line-height:1;font-weight:820;letter-spacing:-.04em}.radial-center span{display:block;font-size:12px;color:var(--muted);margin-top:6px}.chart-voice{margin-top:15px;padding:12px 14px;border:1px solid rgba(0,175,165,.18);border-radius:14px;background:linear-gradient(135deg,rgba(216,251,243,.8),rgba(255,255,255,.68));font-size:13px;color:#28555A}.chart-voice strong{color:var(--teal-dark)}
  .status-stack{height:16px;display:flex;overflow:hidden;border-radius:999px;background:#DDE6EC;box-shadow:inset 0 1px 3px rgba(15,23,42,.08);margin:14px 0 18px}.status-stack span{height:100%;min-width:0}.legend-list{display:grid;gap:9px}.legend-row{display:grid;grid-template-columns:12px 1fr auto auto;gap:9px;align-items:center;font-size:13px}.legend-dot{width:9px;height:9px;border-radius:50%}.legend-row b{font-size:14px}.legend-row small{color:var(--muted);text-align:right;min-width:44px}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.info-item{padding:11px 12px;border:1px solid rgba(155,171,190,.26);border-radius:13px;background:rgba(255,255,255,.56);min-width:0}.info-item span{display:block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;font-weight:800;color:var(--muted)}.info-item strong{display:block;margin-top:3px;font-size:13px;overflow-wrap:anywhere}
  .rank-list{display:grid;gap:13px}.rank-item{min-width:0}.rank-head{display:flex;justify-content:space-between;gap:12px;align-items:baseline;font-size:13px}.rank-head span{font-weight:700;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rank-head strong{font-size:12px;white-space:nowrap}.bar-track{height:9px;border-radius:999px;background:#E1E8EE;overflow:hidden;margin-top:7px}.bar-track>span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--teal),var(--mint));box-shadow:0 0 18px rgba(0,175,165,.2)}.bar-track.danger>span{background:linear-gradient(90deg,#EF4444,#FB7185);box-shadow:0 0 18px rgba(239,68,68,.16)}.rank-item small{display:block;color:var(--muted);font-size:11px;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .coverage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.coverage-group{border:1px solid rgba(155,171,190,.28);border-radius:15px;overflow:hidden;background:rgba(255,255,255,.54)}.coverage-head{display:flex;justify-content:space-between;gap:12px;padding:11px 13px;background:rgba(245,248,251,.76);border-bottom:1px solid rgba(155,171,190,.22);font-size:12px}.coverage-row{display:grid;grid-template-columns:1fr 130px;gap:12px;align-items:center;padding:11px 13px;border-bottom:1px solid rgba(155,171,190,.18)}.coverage-row:last-child{border-bottom:0}.coverage-copy strong{display:block;font-size:13px}.coverage-copy small{display:block;font-size:11px;color:var(--muted);margin-top:2px}.coverage-rate strong{display:block;text-align:right;color:var(--teal-dark);font-size:12px}
  .results-card{overflow:visible}.results-card:after{display:none}.results-heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-end}.results-heading p{color:var(--muted);font-size:13px;margin-top:4px}.result-count{font-size:12px;color:var(--muted)}
  .control-dock{position:sticky;top:10px;z-index:8;margin:18px 0 14px;padding:11px;border:1px solid rgba(155,171,190,.34);border-radius:18px;background:rgba(248,251,253,.78);box-shadow:0 18px 40px -28px rgba(24,45,68,.45),inset 0 1px 0 rgba(255,255,255,.82);-webkit-backdrop-filter:blur(22px) saturate(1.18);backdrop-filter:blur(22px) saturate(1.18)}
  .control-primary{display:grid;grid-template-columns:minmax(260px,1fr) auto auto;gap:9px;align-items:center}.search-shell{position:relative}.search-shell .search-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:18px;pointer-events:none}.control-dock input[type=search],.control-dock select{width:100%;height:42px;border:1px solid rgba(126,145,166,.38);border-radius:12px;background:rgba(255,255,255,.9);color:var(--ink);outline:none;transition:border-color .16s,box-shadow .16s,background .16s}.control-dock input[type=search]{padding:0 14px 0 39px}.control-dock select{padding:0 30px 0 11px}.control-dock input:focus,.control-dock select:focus{border-color:rgba(0,175,165,.65);box-shadow:0 0 0 4px rgba(0,175,165,.105);background:#fff}
  .filter-button{height:42px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;border-radius:12px;border:1px solid rgba(0,175,165,.22);background:linear-gradient(135deg,#00BDB2,#008F88);color:white;font-weight:780;font-size:13px;box-shadow:0 10px 24px -14px rgba(0,143,136,.72),inset 0 1px 0 rgba(255,255,255,.22);transition:transform .16s,box-shadow .16s}.filter-button:hover{transform:translateY(-1px);box-shadow:0 14px 28px -14px rgba(0,143,136,.8),inset 0 1px 0 rgba(255,255,255,.22)}.filter-button.secondary{color:var(--teal-dark);background:rgba(255,255,255,.82);border-color:rgba(126,145,166,.34);box-shadow:none}.filter-button.secondary:hover{background:#fff;box-shadow:0 8px 20px -16px rgba(24,45,68,.46)}
  .control-secondary{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr)) auto;gap:8px;margin-top:8px}.control-label{min-width:0}.control-label>span{display:block;margin:0 0 4px 2px;color:var(--muted);font-size:9px;font-weight:850;letter-spacing:.075em;text-transform:uppercase}.failed-chip{height:42px;align-self:end;display:flex;align-items:center;gap:8px;padding:0 11px;border:1px solid rgba(126,145,166,.34);border-radius:12px;background:rgba(255,255,255,.82);font-size:12px;font-weight:700;white-space:nowrap}.failed-chip input{width:15px;height:15px;accent-color:var(--red)}
  .scenario-table{width:100%;border-collapse:separate;border-spacing:0}.scenario-table th{text-align:left;padding:10px 11px;border-bottom:1px solid rgba(126,145,166,.25);background:rgba(244,247,251,.72);color:var(--muted);font-size:10px;letter-spacing:.06em;text-transform:uppercase}.scenario-table td{padding:12px 11px;border-bottom:1px solid rgba(126,145,166,.19);font-size:13px;vertical-align:middle}.scenario-table tbody tr[data-scenario-row]:hover{background:rgba(236,252,251,.5)}
  .scenario-name{font-weight:730}.scenario-meta{display:block;font-size:11px;color:var(--muted);margin-top:2px}.status-pill{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:999px;border:1px solid;font-size:10px;font-weight:850;letter-spacing:.045em}.status-passed{color:#15803D;background:#F0FDF4;border-color:#BBF7D0}.status-failed{color:#B91C1C;background:#FEF2F2;border-color:#FECACA}.status-skipped,.status-undefined{color:#475569;background:#F8FAFC;border-color:#CBD5E1}.status-pending{color:#A16207;background:#FFFBEB;border-color:#FDE68A}
  .detail-button{height:32px;padding:0 10px;border:1px solid rgba(0,175,165,.25);border-radius:9px;background:rgba(236,252,251,.76);color:var(--teal-dark);font-size:11px;font-weight:800}.detail-button:hover{background:#D8FBF3}
  .detail-row td{padding:0!important;background:rgba(249,252,253,.82)}.detail-panel{padding:16px 18px 18px;border-left:3px solid var(--teal)}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.step-list{display:grid;gap:6px}.step-item{display:grid;grid-template-columns:10px minmax(0,1fr) auto;gap:8px;align-items:start;padding:8px 9px;border:1px solid rgba(126,145,166,.2);border-radius:10px;background:rgba(255,255,255,.78)}.step-dot{width:8px;height:8px;border-radius:50%;margin-top:6px}.error-box{white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:10px;border:1px solid #FECACA;border-radius:10px;background:#FEF2F2;color:#7F1D1D;font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}
  .empty-state{padding:18px;border:1px dashed rgba(126,145,166,.34);border-radius:14px;background:rgba(255,255,255,.5);color:var(--muted);font-size:13px;text-align:center}
  .report-footer{padding:22px 4px 0;color:var(--muted);font-size:12px;text-align:center}.report-footer strong{color:var(--ink)}
  @@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.overall-panel{max-width:420px}.span-8,.span-7,.span-6,.span-5,.span-4{grid-column:span 12}.status-chart-card{min-height:0}.coverage-grid{grid-template-columns:1fr}.control-secondary{grid-template-columns:repeat(2,minmax(140px,1fr))}.chart-layout{grid-template-columns:1fr}.radial-chart{width:210px;height:210px}.radial-chart:before{inset:26px}}
  @@media(max-width:700px){.report-page{width:min(100% - 20px,1280px);padding-top:12px}.hero{padding:24px 20px;border-radius:24px}.brand-row{align-items:flex-start;flex-direction:column;gap:8px}.hero h1{font-size:30px}.bento-grid{gap:10px}.card-pad{padding:18px}.control-dock{top:6px}.control-primary,.control-secondary{grid-template-columns:1fr}.control-primary .filter-button{width:100%}.scenario-table thead{display:none}.scenario-table,.scenario-table tbody,.scenario-table tr,.scenario-table td{display:block;width:100%}.scenario-table tr[data-scenario-row]{padding:10px 0;border-bottom:1px solid rgba(126,145,166,.22)}.scenario-table tr[data-scenario-row] td{border:0;padding:5px 9px}.scenario-table td[data-label]:before{content:attr(data-label);display:block;color:var(--muted);font-size:9px;font-weight:850;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}.detail-grid{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}.chart-layout{gap:14px}}
</style>
