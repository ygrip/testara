@import io.github.ygrip.testara.reporter.model.ReportTheme
@import io.github.ygrip.testara.reporter.view.ReportView
@param ReportView view
@param ReportTheme theme
<tr><td style="padding:22px 28px 26px 28px;">
  @if(view.metadata().reportLink() != null && !view.metadata().reportLink().isBlank())
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:18px;"><tr><td style="background:${theme.accent()};border-radius:7px;"><a href="${view.metadata().reportLink()}" style="display:inline-block;padding:10px 16px;color:#ffffff;text-decoration:none;font-size:12px;font-weight:700;">View full report</a></td></tr></table>
  @endif
  <div style="padding-top:16px;border-top:1px solid ${theme.borderColor()};font-size:11px;line-height:17px;color:${theme.mutedColor()};">
    Generated by ${view.branding().organizationName()} on ${view.metadata().generatedAt()}
    @if(view.branding().organizationDetail() != null)
      <br>${view.branding().organizationDetail()}
    @endif
  </div>
</td></tr>
